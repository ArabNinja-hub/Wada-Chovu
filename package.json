{
  "name": "chovu-chovu-brothers",
  "private": true,
  "version": "1.0.0",
  "description": "Chovu Chovu Brothers Ltd website: a large retail shop in Luanshya, Zambia. Static, prerendered, with an optional lazy-loaded Three.js scene.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "photos:fetch-model": "python3 scripts/depth/fetch-model.py",
    "photos:depth": "python3 scripts/depth/process-photos.py --sources"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
