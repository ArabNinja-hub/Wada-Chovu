{
  "name": "wada-chovu-wholesale",
  "private": true,
  "version": "1.0.0",
  "description": "Wada Chovu Wholesale website: static, prerendered, with an optional lazy-loaded Three.js scene.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "placeholders": "node scripts/generate-placeholders.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
